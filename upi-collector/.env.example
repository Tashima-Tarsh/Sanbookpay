PORT=3000
HOST=127.0.0.1

# Device key shared with the Android observer app
DEVICE_KEY=

# Webhook HMAC secret (hex)
WH_SECRET=

# ntfy topic for push alerts
NTFY_TOPIC=

# Gmail API OAuth2 (gmail.send scope only)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Payer email from address
GMAIL_FROM=

# Reconcile job schedule (cron)
RECONCILE_CRON=0 2 * * *
