PORT=3000
HOST=127.0.0.1

# Device key shared with the Android observer app
DEVICE_KEY=

# Webhook HMAC secret (hex)
WH_SECRET=

# ntfy topic for push alerts (public ntfy.sh, self-host later)
NTFY_TOPIC=

# --- Universal Gmail adapter (any Gmail ID works) ---
# Each merchant runs `npm run gmail-auth` once to get their refresh token.
# No per-user code changes — credentials come from .env only.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_FROM=

# --- Universal SMS adapter (any phone, no paid gateway) ---
# Install android-sms-gateway app on your own Android phone.
# Set SMS_GATEWAY_URL=http://<phone-lan-ip>:9090
SMS_GATEWAY_URL=

# Reconcile job schedule (cron)
RECONCILE_CRON=0 2 * * *
