    "/v1.0/merchant/webhook": {
      "post": {
        "summary": "Configure callback and server IP allowlist",
        "parameters": [
          {
            "name": "Client-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Client-Secret",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Service-Id",
            "in": "header",
