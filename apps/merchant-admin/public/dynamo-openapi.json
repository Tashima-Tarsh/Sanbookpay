      "MerchantCallback": {
        "type": "object",
        "description": "Verify X-Gateway-Signature HMAC-SHA256 over raw bytes. Deduplicate delivery ID and payment/order atomically with game-wallet credit. PAYMENT_DETECTED is PENDING.",
        "properties": {
          "event": {
            "type": "string"
          },
          "merchantId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "amountPaise": {
            "type": "integer"
          },
          "currency": {
            "type": "string",
            "enum": [
              "INR"
            ]
          },
          "status": {
            "type": "string"
          },
          "utr": {
            "type": "string",
            "nullable": true
          },
          "playerReference": {
            "type": "string",
            "nullable": true
          },
          "confirmationSource": {
            "type": "string",
            "nullable": true
          },
          "bankVerified": {
