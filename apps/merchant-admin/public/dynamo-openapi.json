    "/v1/payments": {
      "post": {
        "summary": "Create/replay a payment (payments.create)",
        "security": [
          {
            "MerchantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[-A-Za-z0-9_:]{1,120}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount"
                ],
                "properties": {
                  "amount": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": true,
                        "minimum": 0
                      }
                    ]
                  },
                  "currency": {
                    "type": "string",
                    "enum": [
                      "INR"
                    ]
                  },
                  "orderId": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "playerReference": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "returnUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Absolute HTTPS return page. Navigation is not payment confirmation."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment state and hosted checkout URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string"
                    },
                    "orderId": {
                      "type": "string"
                    },
                    "checkoutUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "status": {
                      "type": "string"
                    },
                    "confirmationSource": {
                      "type": "string",
                      "nullable": true
                    },
                    "amountPaise": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "200": {
            "description": "Payment state and hosted checkout URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string"
                    },
                    "orderId": {
                      "type": "string"
                    },
                    "checkoutUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "status": {
                      "type": "string"
                    },
                    "confirmationSource": {
                      "type": "string",
                      "nullable": true
                    },
                    "amountPaise": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid key"
          },
          "403": {
            "description": "Scope, IP, policy or inactive merchant"
          },
          "409": {
            "description": "Idempotency conflict"
          },
          "429": {
            "description": "Rate limited; observe Retry-After"
          }
        }
      }
    },
    "/v1/payments/{paymentId}": {
      "get": {
        "summary": "Read status (payments.read)",
        "security": [
          {
            "MerchantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "paymentId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Payment state and hosted checkout URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paymentId": {
                      "type": "string"
                    },
                    "orderId": {
                      "type": "string"
                    },
                    "checkoutUrl": {
                      "type": "string",
                      "format": "uri"
                    },
                    "status": {
                      "type": "string"
                    },
                    "confirmationSource": {
                      "type": "string",
                      "nullable": true
                    },
                    "amountPaise": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Payment absent or belongs to another merchant"
          }
        }
      }
    },
    "/v1/refunds": {
      "post": {
        "summary": "Create/replay a supported provider refund (refunds.create)",
        "security": [
          {
            "MerchantBearer": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[-A-Za-z0-9_:]{1,120}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "paymentId"
                ],
                "properties": {
                  "paymentId": {
                    "type": "string"
                  },
                  "amount": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^\\d+(\\.\\d{1,2})?$"
                      },
                      {
                        "type": "number",
                        "exclusiveMinimum": true,
                        "minimum": 0
                      }
                    ]
                  },
                  "refundId": {
                    "type": "string"
                  },
                  "reason": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Refund reserved/submitted"
          },
          "200": {
            "description": "Original refund returned"
          },
          "409": {
            "description": "Idempotency or refundable-balance conflict"
          }
        }
      }
    }
  },
