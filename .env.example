# DYNAMO PAY — Environment Template
# Copy to `.env` and fill in real values. Never commit your real `.env`.

# Environment
NODE_ENV=production

# Server bind (0.0.0.0 inside containers; 127.0.0.1 for local)
YOUPI_BIND_HOST=127.0.0.1
PAYMENT_API_PORT=6100

# Database (PostgreSQL optional; omit for SQLite)
DATABASE_URL=
DB_PASSWORD=

# Redis (optional cache; not the durable record)
REDIS_URL=

# Crypto (required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_MASTER_KEY=
JWT_SECRET=

# Base URLs
BASE_CHECKOUT_URL=https://checkout.example.com
BASE_PAYMENT_API_URL=https://api.example.com

# Webhook
WEBHOOK_MAX_RETRIES=5
CALLBACK_MAX_CONCURRENCY=50
CALLBACK_PER_MERCHANT_CONCURRENCY=5

# UPI Mirror feature flags
UPI_MIRROR_ENABLED=true
UPI_MIRROR_OBSERVATION_ENABLED=true
UPI_MIRROR_DEVICE_PAIRING_ENABLED=true
UPI_MIRROR_WEBHOOK_ENABLED=true
