# DYNAMO PAY — Environment Template
# Copy to `.env` and fill in real values. Never commit your real `.env`.

# Environment
NODE_ENV=production

# Server bind (0.0.0.0 inside containers; 127.0.0.1 for local)
YOUPI_BIND_HOST=127.0.0.1
PAYMENT_API_PORT=6100

# Database (PostgreSQL optional; omit for SQLite)
DATABASE_URL=
DB_PASSWORD=

# Redis (optional cache; not the durable record)
REDIS_URL=

# Crypto (required in production; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_MASTER_KEY=
JWT_SECRET=

# Base URLs
BASE_CHECKOUT_URL=https://checkout.example.com
BASE_PAYMENT_API_URL=https://api.example.com

# Webhook
WEBHOOK_MAX_RETRIES=5
CALLBACK_MAX_CONCURRENCY=50
CALLBACK_PER_MERCHANT_CONCURRENCY=5

# UPI Mirror feature flags
UPI_MIRROR_ENABLED=true
UPI_MIRROR_OBSERVATION_ENABLED=true
UPI_MIRROR_DEVICE_PAIRING_ENABLED=true
UPI_MIRROR_WEBHOOK_ENABLED=true

# Outgoing notifications (separate from payment-observer credentials)
# Run npm run notifications:setup to generate a random topic privately.
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
# Gmail API send-only OAuth, npm run gmail-auth; token saved in data/.secrets/
GMAIL_SEND_CLIENT_ID=
GMAIL_SEND_CLIENT_SECRET=
GMAIL_SEND_FROM=
# Optional alternative to the local private token file:
GMAIL_SEND_REFRESH_TOKEN=
# SMSGate Android app in Local Server mode, same LAN, authenticated.
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# Optional operator-owned Hyperswitch installation; local HTTP is SANDBOX only.
HYPERSWITCH_SANDBOX_BASE_URL=
HYPERSWITCH_SANDBOX_CHECKOUT_ORIGIN=
HYPERSWITCH_PRODUCTION_BASE_URL=
HYPERSWITCH_PRODUCTION_CHECKOUT_ORIGIN=
HYPERSWITCH_API_KEY=
HYPERSWITCH_MERCHANT_ID=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_WEBHOOK_SECRET=
